{
  "name": "slide-planner",
  "productName": "Slide Planner",
  "version": "0.1.0",
  "description": "Slide Planner: AI-assisted lesson slides for teachers. Local, single-user desktop app.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "build:debug": "electron-vite build --sourcemap",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "check": "node scripts/check.mjs",
    "spec": "node scripts/spec.mjs",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "test:e2e": "electron-vite build && node scripts/e2e/run.mjs",
    "shot": "node scripts/shot.mjs",
    "perf": "node scripts/perf.mjs",
    "new:module": "node scripts/new-module.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "docx": "^9.8.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-xml-parser": "^5.11.2",
    "happy-dom": "^20.14.5",
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
